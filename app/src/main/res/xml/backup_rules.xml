<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <!-- Exclude large downloaded offline map packs & extracted Valhalla tiles from 25 MB cloud backup
         so app upgrades preserve Room DB metadata, DataStore preferences, and local files cleanly. -->
    <exclude domain="file" path="packs" />
    <exclude domain="file" path="valhalla_tiles" />
</full-backup-content>

