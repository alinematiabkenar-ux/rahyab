<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude large downloaded state packs & Valhalla tiles from 25 MB cloud backup quota
             so Room DB and DataStore settings back up reliably while device storage preserves packs across upgrades. -->
        <exclude domain="file" path="packs" />
        <exclude domain="file" path="valhalla_tiles" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore" />
    </device-transfer>
</data-extraction-rules>

